{
  "name": "dsh-hermes-feishu",
  "version": "1.0.0",
  "description": "Feishu/Lark channel for DeepSeek Harness: WebSocket inbound messaging, Markdown tables rendered as native Feishu table components, 13 Feishu tools, a web settings page, voice and media.",
  "license": "MIT",
  "author": "lishuaibing",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lishuaibing521/dsh-hermes-feishu.git"
  },
  "homepage": "https://github.com/lishuaibing521/dsh-hermes-feishu#readme",
  "bugs": {
    "url": "https://github.com/lishuaibing521/dsh-hermes-feishu/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "feishu",
    "lark",
    "channel",
    "bot",
    "messaging"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./render": {
      "default": "./lib/render.js"
    },
    "./feishu": {
      "default": "./lib/feishu.js"
    },
    "./inbound": {
      "default": "./lib/inbound.js"
    },
    "./inbound-ws": {
      "default": "./lib/inbound-ws.js"
    },
    "./dispatch": {
      "default": "./lib/dispatch.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@larksuiteoapi/node-sdk": "^1.74.0"
  }
}
