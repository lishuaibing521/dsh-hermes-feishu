# 统一行尾策略：仓库内存 LF，任何平台检出都保持 LF
* text=auto eol=lf

# Windows 批处理 / PowerShell 必须保持 CRLF，否则 cmd 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
